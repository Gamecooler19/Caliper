# Caliper environment variables -- example only, never commit real values.
#
# Per architecture.md's Security posture and backend/app/security/secrets.py:
# secrets are injected by the deployment environment (container
# orchestrator, systemd unit, CI secrets store), never read from a
# committed file. Copy this to `.env` locally for `docker compose up`, and
# never commit the real `.env`.

# PostgreSQL 16 async connection string (SQLAlchemy 2 + asyncpg driver).
DATABASE_URL=postgresql+asyncpg://caliper:caliper@postgres:5432/caliper
POSTGRES_USER=caliper
POSTGRES_PASSWORD=caliper
POSTGRES_DB=caliper

# Valkey connection string: Celery broker + API rate-limiter backing store.
VALKEY_URL=redis://valkey:6379/0

# Bring-your-own-key Meta Model API credential. Required starting with
# Module 2 (vision pipeline): this is the first module that actually
# calls the Meta Model API, and a missing key fails fast when the vision
# pipeline is invoked rather than failing silently mid-request. Not
# needed to bring up docker compose itself (API/Postgres/Valkey/Caddy
# health check), only to exercise app.vision.pipeline.extract_vision_flags.
META_MODEL_API_KEY=

# Meta Model API model IDs used by the vision pipeline. Both have
# defaults (sam-3.1, muse-spark-1.3) baked into the secrets layer; set
# these only to override.
SAM_MODEL_ID=sam-3.1
MUSE_SPARK_MODEL_ID=muse-spark-1.3

# S3-compatible object storage for uploaded device media
# (backend/app/storage/media.py). Required to call upload_media/
# fetch_media; not needed to bring up docker compose itself.
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=

# Live Meta Model API integration test gate. Leave unset (or 0) by
# default -- set to 1 only to intentionally run
# backend/tests/integration/test_vision_pipeline_live.py, which consumes
# real hackathon API credit.
RUN_LIVE_META_API_TESTS=0

# Caddy reverse-proxy TLS domain. Defaults to localhost (Caddy's internal
# self-signed CA) for local development; set to a real hostname in
# production to get an automatic ACME/Let's Encrypt certificate.
CALIPER_DOMAIN=localhost
HTTP_PORT=80
HTTPS_PORT=443
