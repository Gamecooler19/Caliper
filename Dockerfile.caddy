# syntax=docker/dockerfile:1
#
# Module 5: builds the Vite production frontend and layers it into the
# official Caddy image as static files, so `docker compose up` serves
# the frontend through Caddy's existing single HTTPS entrypoint --
# no new container and no new exposed port beyond what Caddy already
# publishes (see docker-compose.yml, ${HTTPS_PORT:-443}/${HTTP_PORT:-80}).

FROM node:22-alpine AS frontend-build
WORKDIR /srv/frontend

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

COPY frontend ./
RUN npm run build

# ---------------------------------------------------------------------------

FROM caddy:2-alpine

# The Caddyfile itself is still bind-mounted read-only from the repo
# root at runtime (see docker-compose.yml's caddy.volumes) so a config
# change doesn't require a rebuild; only the static frontend build
# output is baked into this image.
COPY --from=frontend-build /srv/frontend/dist /srv/frontend
